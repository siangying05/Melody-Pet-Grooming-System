@{
    ViewBag.Title = "Password Reset Success";
}

<a asp-controller="Account" asp-action="Login" class="btn btn-primary">
    Return to Home
</a>
<div class="alert alert-success">
    <h4>Password Reset Successfully!</h4>

    <div class="mt-3">
        <p>New password for user: <strong>@ViewBag.Email</strong></p>

        <div class="input-group mb-3">
            <input type="text"
                   class="form-control"
                   id="newPassword"
                   value="@ViewBag.ResetPassword"
                   readonly>
            <button class="btn btn-outline-secondary"
                    type="button"
                    onclick="copyPassword()">
                Copy
            </button>
        </div>

        <div class="alert alert-warning">
            <small>
                <i class="bi bi-exclamation-triangle"></i>
                Please save this password immediately. It will not be shown again.
            </small>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function copyPassword() {
            var copyText = document.getElementById("newPassword");
            copyText.select();
            copyText.setSelectionRange(0, 99999); // For mobile devices

            navigator.clipboard.writeText(copyText.value)
                .then(() => {
                    // Show success message
                    alert("Password copied to clipboard!");
                })
                .catch(err => {
                    console.error('Failed to copy: ', err);
                });
        }

        // Auto copy on page load (optional)
        // document.addEventListener('DOMContentLoaded', function() {
        //     copyPassword();
        // });
    </script>
}