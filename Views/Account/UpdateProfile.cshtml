@model Melody.Models.MyUpdateProfileVM
@{
    ViewBag.Title = "Update Profile";
    Layout = "_Layout";
}

<div class="update-profile-page">
    <h2>Update Profile</h2>
    <hr />

    @if (TempData["Info"] != null)
    {
        <div class="alert-success">
            @TempData["Info"]
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-danger">
            @Html.ValidationSummary(true)
        </div>
    }
    <a asp-controller="Account" asp-action="Profile" class="Back">Back to Profile</a>

    <form asp-action="UpdateProfile" method="post" class="update-profile-form">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" class="form-control" readonly />
        </div>

        <div class="form-group required">
            <label asp-for="Name">Name</label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="validation-message"></span>
        </div>

        <div class="form-group">
            <label asp-for="Phone">Phone</label>
            <input asp-for="Phone" class="form-control" placeholder="e.g., (123) 456-7890" />
            <span asp-validation-for="Phone" class="validation-message"></span>
        </div>

        <div class="form-group">
            <label asp-for="Address">Address</label>
            <textarea asp-for="Address" class="form-control" placeholder="e.g., 123 Pet Street, Animal City"></textarea>
            <span asp-validation-for="Address" class="validation-message"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">
                Update Profile
            </button>
            <a href="/Account/Profile" class="btn-secondary">
                <span class="cancel-icon">↩️</span>
                Cancel
            </a>
        </div>
    </form>
</div>