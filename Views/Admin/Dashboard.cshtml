@model Melody.Models.AdminDashboardVM
@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "_Layout";
}

<h2>📊 Admin Dashboard</h2>

<div class="admin-stats">
    <div class="admin-stat-card">
        <h3>👤 Users</h3>
        <p>@Model.UsersCount</p>
    </div>

    <div class="admin-stat-card">
        <h3>🐾 Pets</h3>
        <p>@Model.PetsCount</p>
    </div>

    <div class="admin-stat-card">
        <h3>📅 Appointments</h3>
        <p>@Model.AppointmentsCount</p>
    </div>

    <div class="admin-stat-card">
        <h3>🛒 Orders</h3>
        <p>@Model.OrdersCount</p>
    </div>
</div>

<hr />

<h3>📅 Recent Appointments</h3>
<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Pet</th>
            <th>Service</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model.RecentAppointments)
        {
            <tr>
                <td>@a.Date.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@a.Pet?.Name</td>
                <td>@a.Service?.Name</td>
                <td>@a.Status</td>
            </tr>
        }
    </tbody>
</table>

<h3>🛒 Recent Orders</h3>
<table class="table">
    <thead>
        <tr>
            <th>Order #</th>
            <th>Total</th>
            <th>Status</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model.RecentOrders)
        {
            <tr>
                <td>@o.OrderNumber</td>
                <td>$@o.Total</td>
                <td>@o.Status</td>
                <td>@o.CreatedAt.ToString("yyyy-MM-dd")</td>
            </tr>
        }
    </tbody>
</table>