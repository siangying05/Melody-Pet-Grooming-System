@model IEnumerable<Melody.Models.User>

@{
    ViewBag.Title = "User Management";
}
<h2>User Management</h2>

<a asp-action="CreateUser" class="btn btn-primary mb-3">Create User</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Email</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Role</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Email</td>
                <td>@u.Name</td>
                <td>@u.Phone</td>
                <td>@u.Role</td>
                <td>
                    <a asp-action="EditUser" asp-route-email="@u.Email" class="btn btn-warning btn-sm">Edit</a>

                    <form asp-action="DeleteUser" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@u.Email" />
                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('Delete this user (@u.Name)?')">
                            Delete
                        </button>
                    </form>
                </td>

            </tr>
        }
    </tbody>
</table>
