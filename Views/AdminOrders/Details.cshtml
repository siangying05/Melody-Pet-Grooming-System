@model Melody.Models.OrderDetailsVM

@{
    ViewBag.Title = "Admin - Order Details";
}

<link rel="stylesheet" href="~/css/admin-orders.css" />

<div class="admin-container">

    <h2>🧾 Order Details (Admin)</h2>

    <!-- =========================
         ORDER BASIC INFO
         ========================= -->
    <div class="admin-order-info">
        <p><strong>Order #:</strong> @Model.Order.OrderNumber</p>
        <p><strong>Customer Email:</strong> @Model.Order.CustomerEmail</p>
        <p>
            <strong>Status:</strong>
            <span class="status-badge status-@Model.Order.Status.ToLower()">
                @Model.Order.Status
            </span>
        </p>
        <p><strong>Subtotal:</strong> RM @Model.Order.Subtotal.ToString("F2")</p>
        <p><strong>Tax:</strong> RM @Model.Order.Tax.ToString("F2")</p>
        <p><strong>Total:</strong> RM @Model.Order.Total.ToString("F2")</p>
        <p><strong>Created At:</strong> @Model.Order.CreatedAt.ToLocalTime()</p>
        <p><strong>Last Updated:</strong> @Model.Order.UpdatedAt?.ToLocalTime()</p>
    </div>

    <hr />

    <!-- =========================
         SHIPPING INFO
         ========================= -->
    <h3>📦 Shipping Information</h3>
    <p><strong>Address:</strong> @Model.Order.ShippingAddress</p>
    <p><strong>Phone:</strong> @Model.Order.ShippingPhone</p>

    <hr />

    <!-- =========================
         ORDER ITEMS
         ========================= -->
    <h3>🛒 Order Items</h3>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Product ID</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ProductId</td>
                    <td>@item.Quantity</td>
                    <td>RM @item.UnitPrice.ToString("F2")</td>
                    <td>RM @(item.Quantity* item.UnitPrice)</td>
                </tr>
            }
        </tbody>
    </table>

    <hr />

    <!-- =========================
         UPDATE ORDER STATUS
         ========================= -->
    <h3>🔄 Update Order Status</h3>

    <form asp-action="UpdateStatus"
          asp-controller="AdminOrders"
          method="post"
          class="admin-form">

        <input type="hidden" name="id" value="@Model.Order.Id" />

        <select name="status">
            <option value="Pending" selected="@("Pending" == Model.Order.Status)">Pending</option>
            <option value="Completed" selected="@("Completed" == Model.Order.Status)">Completed</option>
            <option value="Cancelled" selected="@("Cancelled" == Model.Order.Status)">Cancelled</option>
            <option value="Refunding" selected="@("Refunding" == Model.Order.Status)">Refunding</option>
            <option value="Refunded" selected="@("Refunded" == Model.Order.Status)">Refunded</option>
            <option value="RefundRejected" selected="@("RefundRejected" == Model.Order.Status)">
                Refund Rejected
            </option>
        </select>

        <button type="submit" class="admin-btn btn-view">
            Update Status
        </button>
    </form>

    <!-- =========================
         REFUND MANAGEMENT
         ========================= -->
    @if (Model.Order.Status == "Refunding")
    {
        <hr />

        <h3>🔁 Refund Request</h3>

        <div class="admin-refund-section">

            <!-- Customer reason -->
            <div class="admin-refund-reason">
                <p class="label">Customer Reason</p>
                <div class="reason-box">
                    @Model.Order.Notes
                </div>
            </div>

            <!-- Actions -->
            <div class="admin-refund-actions">

                <!-- ⭐ POST -->
                <form asp-action="ApproveRefund"
                      asp-controller="AdminOrders"
                      method="post">

                    <input type="hidden" name="id" value="@Model.Order.Id" />

                    <button type="submit" class="admin-btn btn-approve">
                        ✔ Approve Refund
                    </button>
                </form>

                <!-- ⭐ POST -->
                <form asp-action="RejectRefund"
                      asp-controller="AdminOrders"
                      method="post"
                      class="reject-form">

                    <input type="hidden" name="id" value="@Model.Order.Id" />

                    <textarea name="reason"
                          placeholder="Reason for rejection"
                          required></textarea>

                    <button type="submit" class="admin-btn btn-reject">
                        ✖ Reject Refund
                    </button>
                </form>

            </div>
        </div>
    }

    <hr />

    <a asp-action="Index"
       asp-controller="AdminOrders"
       class="admin-back-link">
        ← Back to Orders
    </a>

</div>
