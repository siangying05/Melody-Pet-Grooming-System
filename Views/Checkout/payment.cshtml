@model Melody.Models.CheckoutVM

@{
    ViewBag.Title = "Payment";
    Layout = "_Layout";
}
<h2>Payment</h2>

<form method="post" action="/Payment/Submit">

    <h3>Payment Method: @Model.PaymentMethod</h3>

    @if (Model.PaymentMethod == "CreditCard")
    {
        <h3>Card Information</h3>

        <label>Card Number</label>
        <input type="text" name="CardNumber" required />

        <label>Expiry</label>
        <input type="text" name="Expiry" required />

        <label>CVV</label>
        <input type="text" name="CVV" required />
    }

    @if (Model.PaymentMethod == "OnlineBanking")
    {
        <h3>Select Bank</h3>

        <select name="Bank" id="bankSelect" required>
            <option value="">Select Bank</option>
            <option value="Maybank">Maybank</option>
            <option value="CIMB">CIMB</option>
            <option value="RHB">RHB</option>
            <option value="PublicBank">Public Bank</option>
        </select>

        <br />
    
        <br />
        <button type="button"
                id="goBankBtn"
                style="padding:10px 20px; background:#4f46e5; color:white; border:none; border-radius:6px;">
            Go to Online Banking
        </button>

        <script>
            document.getElementById("goBankBtn").addEventListener("click", function () {

                const bank = document.getElementById("bankSelect").value;

                if (!bank) {
                    alert("Please select a bank!");
                    return;
                }

                let url = "";

                switch (bank) {
                    case "Maybank":
                        url = "https://www.maybank2u.com.my";
                        break;

                    case "CIMB":
                        url = "https://www.cimbclicks.com.my";
                        break;

                    case "RHB":
                        url = "https://online.rhbgroup.com";
                        break;

                    case "PublicBank":
                        url = "https://www.pbebank.com";
                        break;
                }

                window.open(url, "_blank");   // 打开银行网站
                alert("After completing payment, click 'Complete Order'");
            });
        </script>
    }

    @if (Model.PaymentMethod == "CashOnDelivery")
    {
        <p>Cash on Delivery selected. Please prepare exact cash upon delivery.</p>
    }

    <button type="submit"
            style="margin-top:20px; padding:12px 20px; background:#4f46e5; color:white;">
        Complete Order
    </button>

</form>
