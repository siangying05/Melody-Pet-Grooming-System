@{
    ViewBag.Title = "About Us - Melody Pet Grooming";
}

<div class="about-us-container">

    <div class="about-hero">
        <div class="about-hero-content">
            <h1 class="about-hero-title">Our Story of Passion for Pets</h1>
            <p class="about-hero-subtitle">For over a decade, we've been transforming pet grooming into an art of love and care</p>
        </div>
        <div class="about-hero-image">
            <img src="/images/about-hero.jpg" alt="Melody team with happy pets">
        </div>
    </div>

    <div class="mission-vision-section">
        <div class="mission-card">
            <div class="mission-icon">🎯</div>
            <h3>Our Mission</h3>
            <p>To provide exceptional grooming experiences that enhance the wellbeing and happiness of every pet, while building lasting relationships with their loving owners.</p>
        </div>
        <div class="vision-card">
            <div class="vision-icon">🌟</div>
            <h3>Our Vision</h3>
            <p>To become the most trusted and innovative pet care brand, setting new standards in animal welfare and customer service nationwide.</p>
        </div>
    </div>

    <div class="values-section">
        <div class="section-header">
            <h2>Our Core Values</h2>
            <p>The principles that guide everything we do</p>
        </div>

        <div class="values-grid">
            <div class="value-card">
                <div class="value-icon">❤️</div>
                <h3>Compassionate Care</h3>
                <p>Every pet is treated with the same love and attention we'd give our own family members.</p>
            </div>

            <div class="value-card">
                <div class="value-icon">✨</div>
                <h3>Excellence</h3>
                <p>We constantly refine our techniques and stay updated with the latest grooming innovations.</p>
            </div>

            <div class="value-card">
                <div class="value-icon">🛡️</div>
                <h3>Safety First</h3>
                <p>Your pet's comfort and security are our top priorities in every procedure.</p>
            </div>

            <div class="value-card">
                <div class="value-icon">🤝</div>
                <h3>Integrity</h3>
                <p>Honest communication and transparent pricing build the trust we cherish.</p>
            </div>
        </div>
    </div>

    <div class="team-section">
        <div class="section-header">
            <h2>Meet Our Expert Team</h2>
            <p>Certified professionals with hearts of gold</p>
        </div>

        <div class="team-grid">
            <div class="team-member">
                <div class="member-photo">
                    <img src="/images/team-1.jpg" alt="Sarah Johnson - Lead Groomer">
                </div>
                <div class="member-info">
                    <h3>Sarah Johnson</h3>
                    <p class="member-role">Lead Groomer & Founder</p>
                    <p class="member-bio">With 15+ years of experience and multiple certifications, Sarah founded Melody with a vision to revolutionize pet grooming.</p>
                    <div class="member-certifications">
                        <span class="cert-badge">NDGAA Certified</span>
                        <span class="cert-badge">CPR Certified</span>
                    </div>
                </div>
            </div>

            <div class="team-member">
                <div class="member-photo">
                    <img src="/images/team-2.jpg" alt="Mike Chen - Master Groomer">
                </div>
                <div class="member-info">
                    <h3>Mike Chen</h3>
                    <p class="member-role">Master Groomer</p>
                    <p class="member-bio">Specializing in breed-specific cuts and anxious pets, Mike brings patience and expertise to every grooming session.</p>
                    <div class="member-certifications">
                        <span class="cert-badge">IKG Certified</span>
                        <span class="cert-badge">Behavior Specialist</span>
                    </div>
                </div>
            </div>

            <div class="team-member">
                <div class="member-photo">
                    <img src="/images/team-3.jpg" alt="Emma Rodriguez - Pet Stylist">
                </div>
                <div class="member-info">
                    <h3>Emma Rodriguez</h3>
                    <p class="member-role">Senior Pet Stylist</p>
                    <p class="member-bio">Emma's creative flair and gentle approach make her a favorite among our long-haired and show breed clients.</p>
                    <div class="member-certifications">
                        <span class="cert-badge">Creative Grooming</span>
                        <span class="cert-badge">First Aid Certified</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="facilities-section">
        <div class="section-header">
            <h2>State-of-the-Art Facilities</h2>
            <p>Designed with your pet's comfort in mind</p>
        </div>

        <div class="facilities-features">
            <div class="facility-feature">
                <div class="feature-icon">🛁</div>
                <h3>Hydrotherapy Baths</h3>
                <p>Temperature-controlled bathing systems with adjustable water pressure for maximum comfort.</p>
            </div>

            <div class="facility-feature">
                <div class="feature-icon">🌿</div>
                <h3>Natural Products</h3>
                <p>We use only organic, hypoallergenic shampoos and conditioners that are safe for sensitive skin.</p>
            </div>

            <div class="facility-feature">
                <div class="feature-icon">🎵</div>
                <h3>Calming Environment</h3>
                <p>Soothing music, pheromone diffusers, and private grooming stations reduce stress and anxiety.</p>
            </div>

            <div class="facility-feature">
                <div class="feature-icon">🔬</div>
                <h3>Sanitation Protocol</h3>
                <p>Hospital-grade sterilization of all tools and equipment after each use to prevent cross-contamination.</p>
            </div>
        </div>
    </div>

    <div class="timeline-section">
        <div class="section-header">
            <h2>Our Journey</h2>
            <p>Milestones in our commitment to pet care excellence</p>
        </div>

        <div class="timeline">
            <div class="timeline-item">
                <div class="timeline-year">2010</div>
                <div class="timeline-content">
                    <h3>Humble Beginnings</h3>
                    <p>Melody started as a small mobile grooming service with one van and a big dream.</p>
                </div>
            </div>

            <div class="timeline-item">
                <div class="timeline-year">2014</div>
                <div class="timeline-content">
                    <h3>First Salon Opens</h3>
                    <p>Opened our flagship location, introducing premium grooming packages and retail products.</p>
                </div>
            </div>

            <div class="timeline-item">
                <div class="timeline-year">2018</div>
                <div class="timeline-content">
                    <h3>Certification Excellence</h3>
                    <p>All groomers achieved national certification, emphasizing our commitment to professional standards.</p>
                </div>
            </div>

            <div class="timeline-item">
                <div class="timeline-year">2022</div>
                <div class="timeline-content">
                    <h3>Community Recognition</h3>
                    <p>Awarded "Best Pet Grooming Service" by local community for three consecutive years.</p>
                </div>
            </div>

            <div class="timeline-item">
                <div class="timeline-year">Present</div>
                <div class="timeline-content">
                    <h3>Expanding Our Family</h3>
                    <p>Serving over 5,000 happy pets and continuing to innovate in pet care technology.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="community-section">
        <div class="community-content">
            <h2>Giving Back to Our Community</h2>
            <p>We believe in supporting the community that supports us. Each month, we donate a portion of our proceeds to local animal shelters and rescue organizations. Our team regularly volunteers at adoption events and provides free grooming for shelter animals.</p>
            <div class="community-stats">
                <div class="community-stat">
                    <div class="stat-number">500+</div>
                    <div class="stat-label">Shelter Pets Groomed</div>
                </div>
                <div class="community-stat">
                    <div class="stat-number">$25k+</div>
                    <div class="stat-label">Donated to Rescues</div>
                </div>
                <div class="community-stat">
                    <div class="stat-number">100+</div>
                    <div class="stat-label">Adoption Events</div>
                </div>
            </div>
        </div>
    </div>

    <div class="about-cta">
        <div class="cta-content">
            <h2>Experience the Melody Difference</h2>
            <p>Join our family of satisfied pet parents and let us show you why we're more than just a grooming salon.</p>
            <div class="cta-buttons">
                <a asp-controller="Service" asp-action="Services" class="btn-primary btn-large">Book Your First Visit</a>
                <a href="#" class="btn-secondary btn-large">Contact Our Team</a>
            </div>
        </div>
    </div>
</div>

<style>
    .about-us-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .about-hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
        padding: 80px 0;
        background: linear-gradient(135deg, #f8f9ff 0%, #ffffff 100%);
        border-radius: 20px;
        margin: 30px 0;
        padding: 60px;
    }

    .about-hero-content {
        padding-right: 40px;
    }

    .about-hero-title {
        font-size: 3.5rem;
        font-weight: 700;
        color: #2d3748;
        margin-bottom: 20px;
        line-height: 1.2;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .about-hero-subtitle {
        font-size: 1.25rem;
        color: #4a5568;
        line-height: 1.6;
        margin-bottom: 30px;
    }

    .about-hero-image {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
    }

        .about-hero-image:hover {
            transform: translateY(-5px);
        }

        .about-hero-image img {
            width: 100%;
            height: 500px;
            object-fit: fill;
            border-radius: 15px;
        }

    .mission-vision-section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        margin: 80px 0;
    }

    .mission-card, .vision-card {
        background: white;
        padding: 40px;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        text-align: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid #e2e8f0;
    }

        .mission-card:hover, .vision-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
        }

    .mission-icon, .vision-icon {
        font-size: 3rem;
        margin-bottom: 20px;
    }

    .mission-card h3, .vision-card h3 {
        font-size: 1.75rem;
        color: #2d3748;
        margin-bottom: 15px;
    }

    .mission-card p, .vision-card p {
        color: #4a5568;
        line-height: 1.6;
        font-size: 1.1rem;
    }

    .values-section {
        margin: 100px 0;
    }

    .section-header {
        text-align: center;
        margin-bottom: 60px;
    }

        .section-header h2 {
            font-size: 2.5rem;
            color: #2d3748;
            margin-bottom: 15px;
        }

        .section-header p {
            font-size: 1.2rem;
            color: #718096;
        }

    .values-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
    }

    .value-card {
        background: white;
        padding: 30px;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }

        .value-card:hover {
            border-color: #667eea;
            transform: translateY(-5px);
        }

    .value-icon {
        font-size: 2.5rem;
        margin-bottom: 20px;
    }

    .value-card h3 {
        font-size: 1.5rem;
        color: #2d3748;
        margin-bottom: 15px;
    }

    .value-card p {
        color: #4a5568;
        line-height: 1.6;
    }

    .team-section {
        margin: 100px 0;
        background: linear-gradient(135deg, #f8f9ff 0%, #eef2ff 100%);
        padding: 80px 40px;
        border-radius: 20px;
    }

    .team-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 40px;
        margin-top: 50px;
    }

    .team-member {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s ease;
    }

        .team-member:hover {
            transform: translateY(-10px);
        }

    .member-photo {
        height: 250px;
        overflow: hidden;
    }

        .member-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

    .team-member:hover .member-photo img {
        transform: scale(1.05);
    }

    .member-info {
        padding: 30px;
    }

        .member-info h3 {
            font-size: 1.5rem;
            color: #2d3748;
            margin-bottom: 5px;
        }

    .member-role {
        color: #667eea;
        font-weight: 600;
        margin-bottom: 15px;
        font-size: 1.1rem;
    }

    .member-bio {
        color: #4a5568;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .member-certifications {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .cert-badge {
        background: #eef2ff;
        color: #667eea;
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .facilities-section {
        margin: 100px 0;
    }

    .facilities-features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
    }

    .facility-feature {
        text-align: center;
        padding: 30px;
        background: white;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease;
    }

        .facility-feature:hover {
            transform: translateY(-5px);
        }

    .feature-icon {
        font-size: 2.5rem;
        margin-bottom: 20px;
    }

    .facility-feature h3 {
        font-size: 1.3rem;
        color: #2d3748;
        margin-bottom: 15px;
    }

    .facility-feature p {
        color: #4a5568;
        line-height: 1.6;
    }

    .timeline-section {
        margin: 100px 0;
        position: relative;
    }

    .timeline {
        position: relative;
        padding-left: 50px;
        max-width: 800px;
        margin: 0 auto;
    }

        .timeline:before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: linear-gradient(to bottom, #667eea, #764ba2);
            border-radius: 2px;
        }

    .timeline-item {
        position: relative;
        margin-bottom: 40px;
        padding-left: 40px;
    }

        .timeline-item:before {
            content: '';
            position: absolute;
            left: -53px;
            top: 0;
            width: 20px;
            height: 20px;
            background: white;
            border: 4px solid #667eea;
            border-radius: 50%;
        }

    .timeline-year {
        font-size: 1.5rem;
        font-weight: 700;
        color: #667eea;
        margin-bottom: 10px;
    }

    .timeline-content {
        background: white;
        padding: 25px;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    }

        .timeline-content h3 {
            font-size: 1.3rem;
            color: #2d3748;
            margin-bottom: 10px;
        }

        .timeline-content p {
            color: #4a5568;
            line-height: 1.6;
        }

    .community-section {
        margin: 100px 0;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 80px 40px;
        border-radius: 20px;
        text-align: center;
    }

    .community-content h2 {
        font-size: 2.5rem;
        margin-bottom: 20px;
        color: white;
    }

    .community-content p {
        font-size: 1.2rem;
        line-height: 1.6;
        margin-bottom: 40px;
        opacity: 0.9;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
    }

    .community-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 30px;
        margin-top: 50px;
    }

    .community-stat {
        text-align: center;
    }

        .community-stat .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .community-stat .stat-label {
            font-size: 1.1rem;
            opacity: 0.9;
        }

    .about-cta {
        margin: 80px 0;
        text-align: center;
        padding: 60px 40px;
        background: linear-gradient(135deg, #f8f9ff 0%, #eef2ff 100%);
        border-radius: 20px;
    }

        .about-cta h2 {
            font-size: 2.5rem;
            color: #2d3748;
            margin-bottom: 20px;
        }

        .about-cta p {
            font-size: 1.2rem;
            color: #4a5568;
            margin-bottom: 40px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

    .cta-buttons {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-primary, .btn-secondary {
        padding: 15px 35px;
        border-radius: 50px;
        font-size: 1.1rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
    }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
        }

    .btn-secondary {
        background: white;
        color: #667eea;
        border: 2px solid #667eea;
    }

        .btn-secondary:hover {
            background: #667eea;
            color: white;
            transform: translateY(-3px);
        }

    @@media (max-width: 1024px) {
        .about-hero {
            grid-template-columns: 1fr;
            text-align: center;
            padding: 40px;
        }

        .about-hero-content {
            padding-right: 0;
        }

        .about-hero-title {
            font-size: 2.8rem;
        }

        .mission-vision-section {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .about-hero-title {
            font-size: 2.2rem;
        }

        .section-header h2 {
            font-size: 2rem;
        }

        .team-grid {
            grid-template-columns: 1fr;
        }

        .timeline {
            padding-left: 30px;
        }

            .timeline:before {
                left: -10px;
            }

        .timeline-item {
            padding-left: 30px;
        }

            .timeline-item:before {
                left: -38px;
            }

        .cta-buttons {
            flex-direction: column;
            align-items: center;
        }

        .btn-primary, .btn-secondary {
            width: 100%;
            max-width: 300px;
            text-align: center;
        }
    }

    @@media (max-width: 480px) {
        .about-hero {
            padding: 30px 20px;
        }

        .about-hero-title {
            font-size: 1.8rem;
        }

        .about-hero-subtitle {
            font-size: 1.1rem;
        }

        .section-header h2 {
            font-size: 1.8rem;
        }

        .community-section,
        .team-section {
            padding: 40px 20px;
        }
    }
</style>