            </div>
        }
    </div>
</div>

<div class="cta-section">
    <div class="cta-content">
        <h2>Ready to Pamper Your Pet?</h2>
        <p>Book your appointment today and let your pet experience the Melody difference</p>
        <div class="cta-buttons">
            <a asp-controller="Service" asp-action="BookServices" class="btn-primary btn-large">Book Now & Get 10% Off First Visit</a>
            <a href="/Products" class="btn-secondary btn-large">Shop Our Products</a>
        </div>
        <div class="cta-note">Limited time offer for new customers</div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const carouselConfig = {
            imageBasePath: '/images/',
            imagePrefix: 'grooming',
            imageExtension: '.png',
            minImageNumber: 1,
            maxImageNumber: 10,
            fallbackImage: '/images/default-pet.png'
        };

        const carousel = {
            items: [],
            dots: [],
            currentIndex: 0,
            totalItems: 0,
            autoSlide: null,
            imageUrls: [],

            async checkImageExists(url) {
                return new Promise((resolve) => {
                    const img = new Image();
                    img.onload = () => resolve(true);
                    img.onerror = () => resolve(false);
                    img.src = url;
                });
            },

            async loadAvailableImages() {
                const { imageBasePath, imagePrefix, imageExtension, minImageNumber, maxImageNumber, fallbackImage } = carouselConfig;
                const availableImages = [];

                for (let i = minImageNumber; i <= maxImageNumber; i++) {
                    const imageUrl = `${imageBasePath}${imagePrefix}${i}${imageExtension}`;
                    try {
                        const exists = await this.checkImageExists(imageUrl);
                        if (exists) {
                            availableImages.push(imageUrl);
                        } else {
                            break;
                        }
                    } catch {
                        break;
                    }
                }

                if (availableImages.length === 0) {
                    availableImages.push(fallbackImage);
                }

                this.imageUrls = availableImages;
                return availableImages;
            },

            initCarouselItems() {
                const carouselStack = document.querySelector('.carousel-stack');
                const scrollDots = document.querySelector('.scroll-dots');

                if (!carouselStack || !scrollDots) return;

                carouselStack.innerHTML = '';
                scrollDots.innerHTML = '';

                this.imageUrls.forEach((imageUrl, index) => {
                    const carouselItem = document.createElement('div');
                    carouselItem.className = 'carousel-item';
                    if (index === 0) carouselItem.classList.add('active');

                    const img = document.createElement('img');
                    img.src = imageUrl;
                    img.alt = `Professional pet grooming service ${index + 1}`;
                    img.loading = 'lazy';
                    img.onerror = function() {
                        this.style.display = 'none';
                    };

                    carouselItem.appendChild(img);
                    carouselStack.appendChild(carouselItem);

                    const dot = document.createElement('span');
                    dot.className = 'scroll-dot';
                    if (index === 0) dot.classList.add('active');
                    dot.dataset.index = index;

                    dot.addEventListener('click', () => this.goToIndex(index));
                    scrollDots.appendChild(dot);
                });

                this.items = document.querySelectorAll('.carousel-item');
                this.dots = document.querySelectorAll('.scroll-dot');
                this.totalItems = this.items.length;
            },

            init() {
                this.loadAvailableImages()
                    .then(() => {
                        if (this.imageUrls.length === 0) return;

                        this.initCarouselItems();
                        this.updatePositions();
                        this.startAutoSlide();

                        const container = document.querySelector('.scroll-carousel');
                        if (container) {
                            container.addEventListener('mouseenter', () => this.stopAutoSlide());
                            container.addEventListener('mouseleave', () => this.startAutoSlide());
                        }
                    })
                    .catch(error => {
                        console.error('Error', error);
                    });
            },

            updatePositions() {
                this.items.forEach((item, index) => {
                    item.classList.remove('active', 'prev', 'next');

                    if (index === this.currentIndex) {
                        item.classList.add('active');
                    } else if (index === (this.currentIndex - 1 + this.totalItems) % this.totalItems) {
                        item.classList.add('prev');
                    } else if (index === (this.currentIndex + 1) % this.totalItems) {
                        item.classList.add('next');
                    }
                });

                if (this.dots) {
                    this.dots.forEach((dot, index) => {
                        dot.classList.toggle('active', index === this.currentIndex);
                    });
                }
            },

            moveUp() {
                this.currentIndex = (this.currentIndex - 1 + this.totalItems) % this.totalItems;
                this.updatePositions();
            },

            moveDown() {
                this.currentIndex = (this.currentIndex + 1) % this.totalItems;
                this.updatePositions();
            },

            goToIndex(index) {
                if (index >= 0 && index < this.totalItems) {
                    this.currentIndex = index;
                    this.updatePositions();
                }
            },

            startAutoSlide() {
                this.stopAutoSlide();
                this.autoSlide = setInterval(() => {
                    this.moveDown();
                }, 4000);
            },

            stopAutoSlide() {
                if (this.autoSlide) {
                    clearInterval(this.autoSlide);
                    this.autoSlide = null;
                }
            }
        };

        carousel.init();

        document.querySelectorAll('.btn-add-to-cart:not(:disabled)').forEach(button => {
            button.addEventListener('click', function() {
                const productId = this.dataset.productId;
                if (productId) {
                    addToCart(productId);
                }
            });
        });

        function addToCart(productId) {
            const cartItem = {
                productId: parseInt(productId),
                quantity: 1
            };

            let cart = JSON.parse(localStorage.getItem('melodyCart') || '[]');

            const existingItemIndex = cart.findIndex(item => item.productId === cartItem.productId);
            if (existingItemIndex > -1) {
                cart[existingItemIndex].quantity += 1;
            } else {
                cart.push(cartItem);
            }

            localStorage.setItem('melodyCart', JSON.stringify(cart));

            showNotification('Product added to cart!', 'success');

            updateCartCount();
        }

        function updateCartCount() {
            const cart = JSON.parse(localStorage.getItem('melodyCart') || '[]');
            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);

            const cartIcons = document.querySelectorAll('.cart-count');
            cartIcons.forEach(icon => {
                icon.textContent = totalItems;
                icon.style.display = totalItems > 0 ? 'inline' : 'none';
            });
        }

        function showNotification(message, type) {
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.textContent = message;
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                padding: 15px 25px;
                background: ${type === 'success' ? '#4CAF50' : '#f44336'};
                color: white;
                border-radius: 5px;
                z-index: 1000;
                animation: slideIn 0.3s ease;
                box-shadow: 0 3px 10px rgba(0,0,0,0.2);
            `;

            document.body.appendChild(notification);

            setTimeout(() => {
                notification.style.animation = 'slideOut 0.3s ease';
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.parentNode.removeChild(notification);
                    }
                }, 300);
            }, 3000);
        }

        updateCartCount();
    });
</script>