@model Melody.Models.AddProductVM
@{
    ViewBag.Title = "Add Product";
    Layout = "_Layout";
}

<h2 class="manage-title">➕ Add Product</h2>

<form asp-action="AddProduct"
      asp-controller="ManageProducts"
      method="post"
      enctype="multipart/form-data"
      class="manage-form">

    <label>Name</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name" class="text-danger"></span>

    <label>SKU</label>
    <input asp-for="SKU" placeholder="Leave empty to auto-generate" />

    <label>Description</label>
    <textarea asp-for="Description"></textarea>

    <label>Price</label>
    <input asp-for="Price" type="number" step="0.01" />
    <span asp-validation-for="Price" class="text-danger"></span>

    <label>Brand</label>
    <input asp-for="Brand" />

    <label>Category</label>
    <select asp-for="CategoryId"
            asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
        <option value="">-- Select Category --</option>
    </select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>

    <hr />
    <h3>📦 Inventory</h3>

    <label>Stock Quantity</label>
    <input asp-for="Quantity" type="number" min="0" />

    <label>Minimum Stock</label>
    <input asp-for="MinimumStock" type="number" min="0" />

    <label>Maximum Stock</label>
    <input asp-for="MaximumStock" type="number" min="0" />

    <label>Image</label>
    <input asp-for="Image" type="file" accept="image/*" />
    <span asp-validation-for="Image" class="text-danger"></span>

    <hr />

    <button type="submit">Save</button>
    <a href="/ManageProducts">Cancel</a>
</form>
