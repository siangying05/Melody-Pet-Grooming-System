@model ServiceVM

@{
    ViewBag.Title = "Delete Service";
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="delete-container">
    <h2 class="delete-title">Delete Service</h2>

    <div class="delete-card">
        <p class="delete-warning">
            ⚠ Are you sure you want to delete this service?
        </p>

        <div class="service-info">
            <div>
                <span>Service Name</span>
                <strong>@Model.Name</strong>
            </div>

            <div>
                <span>Price (RM)</span>
                <strong>@Model.Price.ToString("0.00")</strong>
            </div>

            <div>
                <span>Duration</span>
                <strong>@Model.Duration min</strong>
            </div>
        </div>

        <form asp-controller="Service" asp-action="DeleteServices" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="delete-actions">
                <a asp-controller="Service" asp-action="Index" class="btn-cancel">
                    Cancel
                </a>

                <button type="submit" class="btn-delete-confirm">
                    Yes, Delete
                </button>
            </div>
        </form>
    </div>
</div>
